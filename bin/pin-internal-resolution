#!/bin/sh
# Pin the internal panel to 1920x1080.
#
# eDP-1 is natively 3840x2160. Running it at 1920x1080 is the ONLY thing making
# the desktop readable at this size -- there is no Xft.dpi, no GDK/Qt scale
# factor, no compositor scaling anywhere. If the mode ever resets to native
# (session manager re-probing the output, hotplug, resume from suspend) the
# entire desktop becomes unreadably small.
#
# Nothing on disk used to set this, so it survived only as long as the running
# X session did. This script is wired into the i3 config via exec_always.
#
# Note --mode is used rather than --auto: --auto would select the preferred
# mode, which is the native 3840x2160 and exactly what we are avoiding.

OUTPUT=eDP-1
MODE=1920x1080

# Only act when the panel is actually enabled. An enabled output has a
# "WxH+X+Y" geometry on its xrandr line; a disabled one does not. This keeps
# the script from undoing bin/show-on-external-display-only, which
# deliberately switches eDP-1 off in favour of HDMI.
if xrandr --query | grep -Eq "^${OUTPUT} connected.*[0-9]+x[0-9]+\+[0-9]+\+[0-9]+"; then
    xrandr --output "$OUTPUT" --mode "$MODE"
fi
