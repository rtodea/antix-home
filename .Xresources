! Mouse cursor. Covers legacy/Xt apps; XCURSOR_SIZE in ~/.xsessionrc covers
! GTK/Qt/Chrome and the i3 root cursor.
!
! 96 keeps the apparent size the 2x-upscaled setup used to give (48 logical px
! drawn as 96 physical). the largest real DMZ-White pixmap is 48, so 96 is an
! upscale and the edges soften slightly. Adwaita ships a genuine 96 pixmap if a
! sharp cursor matters more than this theme -- switch both lines together.
Xcursor.theme: DMZ-White
Xcursor.size: 96

! xcalc settings
# include ".config/xresources.d/xcalc/xcalc.conf"

! urxvt colours 
# include ".config/xresources.d/xcolours/antix.conf"

! Font rendering. The panel runs natively at 3840x2160 with no xrandr scaling
! (~/.screenlayout/default.sh), which puts it near 282 physical DPI.
!
! Grayscale rather than subpixel: at this pixel density a glyph stem already
! covers several pixels, so subpixel AA buys no real edge detail while still
! tinting edges red/blue. It also keeps rendering identical if the framebuffer
! is ever scaled again. Hinting stays slight -- at 192 logical DPI the glyph
! grid is dense enough that heavier hinting only distorts shapes.
Xft.antialias: 1
Xft.rgba:      none
Xft.lcdfilter: lcdnone
Xft.hinting:   1
Xft.hintstyle: hintslight

! Xft.dpi drives everything that is not GTK or Qt: the i3 font, and -- importantly
! -- the i3 pixel values themselves. Verified at 192: "default_border pixel 2" renders as
! 4 physical px and "gaps inner 6" as 12, so the numbers in the i3 config did
! NOT need doubling for the move to a native framebuffer. Point sizes are
! interpreted through this DPI too, which is why i3 at 11 and roxterm at 22 keep
! the apparent size they had when the framebuffer was upscaled.
Xft.dpi:       192
