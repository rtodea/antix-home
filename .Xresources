! Mouse cursor. DMZ-White ships real 24/32/48 pixmaps, so 48 is a genuine
! size rather than a blurry upscale. Covers legacy/Xt apps; XCURSOR_SIZE in
! ~/.xsessionrc covers GTK/Qt/Chrome and the i3 root cursor.
Xcursor.theme: DMZ-White
Xcursor.size: 48

! xcalc settings
# include ".config/xresources.d/xcalc/xcalc.conf"

! urxvt colours 
# include ".config/xresources.d/xcolours/antix.conf"

! Font rendering. Deliberately grayscale, not subpixel: the panel runs at its
! native 3840x2160 while the framebuffer is 1920x1080 (see ~/.screenlayout/
! default.sh), so every logical pixel is drawn as a 2x2 physical block. Subpixel
! antialiasing assumes it owns the real R/G/B stripes -- under that 2x upscale
! its colour fringes get doubled into visible red/blue edging instead of
! blending away. Grayscale AA has nothing to misalign.
Xft.antialias: 1
Xft.rgba:      none
Xft.lcdfilter: lcdnone
Xft.hinting:   1
Xft.hintstyle: hintslight

! NOTE: Xft.dpi is deliberately NOT set. The large font sizes already in use
! (roxterm at 22, i3 at 11) are the manual compensation for the 2x upscale.
! Setting a real DPI here would apply a second time on top of them and leave
! every font oversized.
