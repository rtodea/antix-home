# This file has been auto-generated by i3-config-wizard(1).
# It will not be overwritten, so edit it as you like.
#
# Should you change your keyboard layout some time, delete
# this file and re-run i3-config-wizard(1).
#

# i3 config file (v4)
#
# Please see https://i3wm.org/docs/userguide.html for a complete reference!

set $mod Mod4

# Tokyo Night. These are the exact values from the roxterm colour scheme in
# ~/.config/roxterm.sourceforge.net/Colours/Tokyo Night, so the window borders
# and the terminal agree. Change them in both places or not at all.
set $bg      #1a1b26
set $fg      #c0caf5
set $accent  #7aa2f7
set $muted   #414868
set $yellow  #e0af68
set $urgent  #f7768e

# Don't hand focus to whatever window happens to slide under the pointer --
# with gaps and no title bars, a stray mouse makes focus feel unpredictable.
focus_follows_mouse no

# Font for window titles. Will also be used by the bar unless a different font
# is used in the bar {} block below.
#
# "Noto Color Emoji" is deliberately NOT listed here — see the note in the
# bar {} block. Emoji in window titles still render fine via fontconfig
# fallback; it is naming the family explicitly that inflates pango's metrics
# and clips the text.
font pango:FiraCode Nerd Font Mono 11

# This font is widely installed, provides lots of unicode glyphs, right-to-left
# text rendering and scalability on retina/hidpi displays (thanks to pango).
#font pango:DejaVu Sans Mono 8

# NOTE: do not add an xrandr call here. The panel resolution is already set at
# session start by ~/.screenlayout/default.sh, which autoscale-antix runs from
# desktop-session. It now runs the panel natively at 3840x2160 with no scale
# transform, and Xft.dpi 192 in ~/.Xresources does the scaling instead.
#
# That DPI also scales i3's own pixel values, so the numbers below are logical,
# not physical: "pixel 2" draws 4 px and "gaps inner 6" leaves 12. Do not double
# them by hand.

# Start XDG autostart .desktop files using dex. See also
# https://wiki.archlinux.org/index.php/XDG_Autostart
exec --no-startup-id dex --autostart --environment i3

# The combination of xss-lock, nm-applet and pactl is a popular choice, so
# they are included here as an example. Modify as you see fit.

# xss-lock grabs a logind suspend inhibit lock and will use i3lock to lock the
# screen before suspend. Use loginctl lock-session to lock your screen.
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock --nofork

# Networking here is connman (connmand is the running daemon), not
# NetworkManager, so the stock nm-applet line is replaced by cmst -- the Qt
# system tray GUI for connman. -m starts it minimized to the tray instead of
# opening the full window, and -w gives i3bar's tray time to appear before the
# icon is docked (without it the icon is silently dropped on a cold start).
exec --no-startup-id cmst -m -w 3

# Use pactl to adjust volume in PulseAudio.
set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +10% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -10% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# move tiling windows via drag & drop by left-clicking into the title bar,
# or left-clicking anywhere into the window while holding the floating modifier.
tiling_drag modifier titlebar

# start a terminal
bindsym $mod+Return exec i3-sensible-terminal

# kill focused window
bindsym $mod+Shift+q kill

# start dmenu (a program launcher)
bindsym $mod+d exec --no-startup-id dmenu_run -i -fn 'FiraCode Nerd Font Mono-11' -nb '$bg' -nf '$fg' -sb '$accent' -sf '$bg'
# A more modern dmenu replacement is rofi:
# bindcode $mod+40 exec "rofi -modi drun,run -show drun"
# There also is i3-dmenu-desktop which only displays applications shipping a
# .desktop file. It is a wrapper around dmenu, so you need that installed.
# bindcode $mod+40 exec --no-startup-id i3-dmenu-desktop

# change focus
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+semicolon focus right

# alternatively, you can use the cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+semicolon move right

# alternatively, you can use the cursor keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# split in horizontal orientation
bindsym $mod+h split h

# split in vertical orientation
bindsym $mod+v split v

# enter fullscreen mode for the focused container
bindsym $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# focus the parent container
bindsym $mod+a focus parent

# focus the child container
#bindsym $mod+d focus child

# A 2px coloured border replaces the title bar: it costs ~24px less height per
# window and the colour already says which window has focus. "smart" drops the
# border entirely when a workspace holds a single window.
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart

# Gaps are native to i3 since 4.22 -- no compositor involved, this is only
# geometry. 6 is deliberate restraint: the framebuffer is 1920x1080 upscaled 2x
# to the 4K panel (see the xrandr note above), so 6 lands as 12 physical px.
# smart_gaps/smart_borders let a lone window go full-bleed.
gaps inner 6
gaps outer 0
smart_gaps on
smart_borders on

# Define names for default workspaces for which we configure key bindings later on.
# We use variables to avoid repeating the names in multiple places.
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# reload the configuration file
bindsym $mod+Shift+c reload
# restart i3 inplace (preserves your layout/session, can be used to upgrade i3)
bindsym $mod+Shift+r restart
# exit i3 (logs you out of your X session)
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'You pressed the exit shortcut. Do you really want to exit i3? This will end your X session.' -B 'Yes, exit i3' 'i3-msg exit'"

# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode

        # Pressing left will shrink the window’s width.
        # Pressing right will grow the window’s width.
        # Pressing up will shrink the window’s height.
        # Pressing down will grow the window’s height.
        bindsym j resize shrink width 10 px or 10 ppt
        bindsym k resize grow height 10 px or 10 ppt
        bindsym l resize shrink height 10 px or 10 ppt
        bindsym semicolon resize grow width 10 px or 10 ppt

        # same bindings, but for the arrow keys
        bindsym Left resize shrink width 10 px or 10 ppt
        bindsym Down resize grow height 10 px or 10 ppt
        bindsym Up resize shrink height 10 px or 10 ppt
        bindsym Right resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape or $mod+r
        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"

# Keyboard pointer control -- the equivalent of Windows' MouseKeys, for when the
# touchpad/TrackPoint stops responding (both went silent at the kernel level on
# 2026-11-12, emitting zero events while being touched).
#
# $mod+m enters the mode; the bar shows "mouse" as the binding-mode indicator if
# it is toggled on with $mod+b. hjkl or the arrows move, Shift moves far, Ctrl
# moves one pixel at a time for precise work, 1/2/3 click left/middle/right,
# 4/5 scroll. Escape, Return or $mod+m leaves.
#
# Steps are in physical pixels on a 3840x2160 screen, so they are larger than
# they would look on a 1080p desktop.
set $p_step   40
set $p_far    300
set $p_fine   1

mode "mouse" {
        bindsym h exec --no-startup-id xdotool mousemove_relative -- -$p_step 0
        bindsym j exec --no-startup-id xdotool mousemove_relative -- 0 $p_step
        bindsym k exec --no-startup-id xdotool mousemove_relative -- 0 -$p_step
        bindsym l exec --no-startup-id xdotool mousemove_relative -- $p_step 0

        bindsym Left  exec --no-startup-id xdotool mousemove_relative -- -$p_step 0
        bindsym Down  exec --no-startup-id xdotool mousemove_relative -- 0 $p_step
        bindsym Up    exec --no-startup-id xdotool mousemove_relative -- 0 -$p_step
        bindsym Right exec --no-startup-id xdotool mousemove_relative -- $p_step 0

        bindsym Shift+h exec --no-startup-id xdotool mousemove_relative -- -$p_far 0
        bindsym Shift+j exec --no-startup-id xdotool mousemove_relative -- 0 $p_far
        bindsym Shift+k exec --no-startup-id xdotool mousemove_relative -- 0 -$p_far
        bindsym Shift+l exec --no-startup-id xdotool mousemove_relative -- $p_far 0

        bindsym Shift+Left  exec --no-startup-id xdotool mousemove_relative -- -$p_far 0
        bindsym Shift+Down  exec --no-startup-id xdotool mousemove_relative -- 0 $p_far
        bindsym Shift+Up    exec --no-startup-id xdotool mousemove_relative -- 0 -$p_far
        bindsym Shift+Right exec --no-startup-id xdotool mousemove_relative -- $p_far 0

        bindsym Control+h exec --no-startup-id xdotool mousemove_relative -- -$p_fine 0
        bindsym Control+j exec --no-startup-id xdotool mousemove_relative -- 0 $p_fine
        bindsym Control+k exec --no-startup-id xdotool mousemove_relative -- 0 -$p_fine
        bindsym Control+l exec --no-startup-id xdotool mousemove_relative -- $p_fine 0

        # clicks and scrolling
        bindsym 1 exec --no-startup-id xdotool click 1
        bindsym 2 exec --no-startup-id xdotool click 2
        bindsym 3 exec --no-startup-id xdotool click 3
        bindsym 4 exec --no-startup-id xdotool click 4
        bindsym 5 exec --no-startup-id xdotool click 5

        # press-and-hold, for drags: d grabs, u releases
        bindsym d exec --no-startup-id xdotool mousedown 1
        bindsym u exec --no-startup-id xdotool mouseup 1

        # jump to the middle of the screen
        bindsym c exec --no-startup-id xdotool mousemove 1920 1080

        bindsym Return mode "default"
        bindsym Escape mode "default"
        bindsym $mod+m mode "default"
}

bindsym $mod+m mode "mouse"

# show/hide the status bar (starts hidden -- see the bar {} block below).
# ~/bin/toggle-i3bar rather than i3's "bar mode toggle": that only flips
# dock <-> hide, and hide still shows the bar whenever hidden_state is "show",
# which puts it on top of window content instead of hiding it.
bindsym $mod+b exec --no-startup-id $HOME/bin/toggle-i3bar

# Window colours. i3's stock palette is blue (#285577) and clashes with the
# Tokyo Night terminal; child_border is the one that actually paints the 2px
# border set above, while "border" only shows on title bars we no longer draw.
#                       border   backgr.  text    indicator  child_border
client.focused          $accent  $accent  $bg     $accent    $accent
client.focused_inactive $muted   $muted   $fg     $muted     $muted
client.unfocused        $bg      $bg      $muted  $bg        $muted
client.urgent           $urgent  $urgent  $bg     $urgent    $urgent
client.placeholder      $bg      $bg      $muted  $bg        $muted
client.background       $bg

# Start i3bar to display a workspace bar (plus the system information i3status
# finds out, if available)
bar {
        id main
        status_command i3status

        # Start with the bar gone, and let $mod+b toggle it via
        # ~/bin/toggle-i3bar. "invisible" is stronger than "hide": a hidden bar
        # is still shown whenever hidden_state flips to "show", which is how it
        # ends up overlaying window content. An invisible bar is never mapped.
        # The script toggles to "dock", which reserves space rather than
        # covering windows.
        #
        # modifier none is kept as a backstop: if the bar is ever put back into
        # hide mode, holding $mod alone still will not reveal it.
        mode invisible
        modifier none
        hidden_state hide

        # Do NOT put "Noto Color Emoji" in this font list. It is a bitmap-only
        # colour font, and pango reports inflated ascent/descent for it. i3bar
        # sizes the bar from those metrics but renders with the primary font,
        # which is what was clipping the status text. FiraCode Nerd Font already
        # carries icon glyphs, so no emoji fallback is needed here.
        font pango:FiraCode Nerd Font Mono 11

        # Breathing room above/below the text so descenders aren't shaved off.
        padding 2px 6px 2px 6px

        separator_symbol " · "

        colors {
                background $bg
                statusline $fg
                separator  $muted

                #                  border   backgr.  text
                focused_workspace  $accent  $accent  $bg
                active_workspace   $muted   $muted   $fg
                inactive_workspace $bg      $bg      $muted
                urgent_workspace   $urgent  $urgent  $bg
                binding_mode       $yellow  $yellow  $bg
        }
}
