[Desktop Entry]
Type=Application
Name=Magnus screen magnifier
Exec=magnus --started-by-keypress
NoDisplay=true

# User-level override of /etc/xdg/autostart/magnus-autostart.desktop.
#
# The system entry is guarded by:
#   AutostartCondition=GSettings org.gnome.desktop.a11y.applications screen-magnifier-enabled
# That key is set to false, but dex (which i3 uses for XDG autostart) does not
# implement AutostartCondition and launches the entry unconditionally. Under a
# MATE/GNOME session the condition is honoured, which is why the magnifier only
# ever appeared under i3.
#
# Files in ~/.config/autostart take precedence over /etc/xdg/autostart, so this
# suppresses it without touching the packaged file (which apt would overwrite).
# To re-enable the magnifier, delete this file.
Hidden=true
